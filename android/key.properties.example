# Copy this file to `key.properties` (same folder) and fill in real values.
# `key.properties` is gitignored — never commit it or your .jks keystore.
#
# Create the keystore first (run in PowerShell, one time):
#   & "C:\Program Files\Android\Android Studio\jbr\bin\keytool.exe" -genkey -v `
#     -keystore $HOME\upload-keystore.jks -keyalg RSA -keysize 2048 `
#     -validity 10000 -alias upload
#
# Then set the four values below to match what you entered.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=C:/Users/geopa/upload-keystore.jks
